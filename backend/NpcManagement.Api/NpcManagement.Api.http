@NpcManagement.Api_HostAddress = http://localhost:5000

GET {{NpcManagement.Api_HostAddress}}/api/npcs
Accept: application/json

###

POST {{NpcManagement.Api_HostAddress}}/api/npcs
Content-Type: application/json

{
  "name": "Greta the Blacksmith",
  "role": "Merchant",
  "location": "Ironforge District",
  "level": 12,
  "isHostile": false,
  "notes": "Sells rare weapon upgrades after the bridge quest."
}

###

# --- Auth & users ---------------------------------------------------------

POST {{NpcManagement.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "alice@example.com",
  "userName": "alice",
  "password": "Passw0rd!"
}

###

# @name login
POST {{NpcManagement.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "Admin123!"
}

###

# Uses the JWT from the login response above.
GET {{NpcManagement.Api_HostAddress}}/api/users
Authorization: Bearer {{login.response.body.token}}
Accept: application/json

###
